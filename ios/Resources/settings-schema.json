{
  "about": "Drives the native settings sheet (App.swift) and the defaults the page sees via dgSetting(). Row types: toggle (bool), choice (string, options = [[value, label], ...]), slider (number, min/max/step), textlist (array of strings, edited one per line), action (button: action = reload | diagnostics | clearLaunchPicture). Keys are camelCase and unique. Feature scripts add their own rows here.",
  "sections": [
    {
      "title": "General",
      "rows": [
        {
          "key": "haptics",
          "type": "toggle",
          "title": "Haptics",
          "default": true
        },
        {
          "key": "highRefresh",
          "type": "toggle",
          "title": "120Hz while scrolling",
          "default": true
        },
        {
          "key": "launchPicture",
          "type": "toggle",
          "title": "Show last chat list at launch",
          "default": true
        },
        {
          "key": "scrollToTopTap",
          "type": "toggle",
          "title": "Tap top of screen to scroll up",
          "default": true
        }
      ]
    },
    {
      "title": "GIFs",
      "rows": [
        {
          "key": "gifRating",
          "type": "choice",
          "title": "Content rating",
          "default": "pg-13",
          "options": [
            [
              "g",
              "G"
            ],
            [
              "pg",
              "PG"
            ],
            [
              "pg-13",
              "PG-13"
            ],
            [
              "r",
              "R"
            ]
          ]
        },
        {
          "key": "gifAutoSend",
          "type": "toggle",
          "title": "Send GIFs immediately when tapped",
          "default": true
        }
      ]
    },
    {
      "title": "Look",
      "rows": [
        {
          "key": "theme",
          "type": "choice",
          "title": "Theme",
          "default": "dark",
          "options": [
            [
              "dark",
              "Dark"
            ],
            [
              "true-black",
              "True black"
            ],
            [
              "midnight",
              "Midnight"
            ]
          ]
        },
        {
          "key": "accent",
          "type": "choice",
          "title": "Accent colour",
          "default": "blue",
          "options": [
            [
              "blue",
              "Snapchat blue"
            ],
            [
              "yellow",
              "Yellow"
            ],
            [
              "purple",
              "Purple"
            ],
            [
              "green",
              "Green"
            ],
            [
              "pink",
              "Pink"
            ]
          ]
        },
        {
          "key": "textSize",
          "type": "slider",
          "title": "Text size",
          "default": 1,
          "min": 0.85,
          "max": 1.3,
          "step": 0.05
        },
        {
          "key": "messageStyle",
          "type": "choice",
          "title": "Message style",
          "default": "blocks",
          "options": [
            [
              "blocks",
              "Blocks"
            ],
            [
              "compact",
              "Compact"
            ]
          ]
        },
        {
          "key": "hideMyAI",
          "type": "toggle",
          "title": "Hide My AI in chat list",
          "default": false
        },
        {
          "key": "hideHeaderIcons",
          "type": "toggle",
          "title": "Hide bell icon",
          "default": false
        },
        {
          "key": "hideBanners",
          "type": "toggle",
          "title": "Hide Snapchat's web banners",
          "default": true
        },
        {
          "key": "reduceMotion",
          "type": "toggle",
          "title": "Reduce motion",
          "default": false
        }
      ]
    },
    {
      "title": "Chats",
      "rows": [
        {
          "key": "quickRepliesShow",
          "type": "toggle",
          "title": "Quick replies row",
          "default": false
        },
        {
          "key": "quickReplies",
          "type": "textlist",
          "title": "Quick replies",
          "default": [
            "On my way!",
            "lol",
            "😂",
            "ok",
            "❤️"
          ]
        },
        {
          "key": "voiceNoteSpeed",
          "type": "choice",
          "title": "Voice note speed",
          "default": "1",
          "options": [
            [
              "1",
              "1x"
            ],
            [
              "1.5",
              "1.5x"
            ],
            [
              "2",
              "2x"
            ]
          ]
        },
        {
          "key": "streakWarn",
          "type": "toggle",
          "title": "Highlight ending streaks",
          "default": true
        }
      ]
    },
    {
      "title": "Troubleshooting",
      "rows": [
        {
